{
  "name": "netlify-to-cloudflare-migrator",
  "version": "1.0.0",
  "description": "Script para migrar configuraciones de Netlify a Cloudflare Pages",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "migrate": "tsx src/index.ts",
    "disable-builds": "tsx src/disable-builds.ts",
    "cf": "tsx src/cloudflare-projects.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "ora": "^7.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "22.22.2"
  },
  "engines": {
    "node": ">=20"
  }
}
