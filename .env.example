# Configuración del proveedor a migrar (cloudflare o render)
TARGET_PROVIDER=cloudflare

# Credenciales para Cloudflare (si TARGET_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui
CLOUDFLARE_API_TOKEN=tu_api_token_aqui

# Credenciales para Render (si TARGET_PROVIDER=render)
RENDER_API_TOKEN=tu_render_api_token_aqui

# Credenciales para leer desde Netlify
NETLIFY_API_TOKEN=tu_netlify_api_token_aqui