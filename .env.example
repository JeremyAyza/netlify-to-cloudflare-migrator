# Target provider: cloudflare (default) or render
TARGET_PROVIDER=cloudflare

# Cloudflare (when TARGET_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# Render (when TARGET_PROVIDER=render)
RENDER_API_TOKEN=your_render_api_token
# Workspace owner ID (own-... or tea-). Optional: detected from the token if empty.
RENDER_OWNER_ID=

# Netlify (API mode and disable-builds)
NETLIFY_API_TOKEN=your_netlify_api_token
